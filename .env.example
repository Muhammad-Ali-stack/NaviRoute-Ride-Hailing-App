# ============================================================
# NaviRoute — example environment configuration
#
# Copy to .env (git-ignored) or export these in your shell / IDE / deployment
# platform. Spring Boot does NOT load .env files automatically.
# All values below are PLACEHOLDERS — never commit real credentials.
# ============================================================

# Active Spring profile: dev (default, local Docker infra) or prod
SPRING_PROFILES_ACTIVE=dev

# ── PostgreSQL ──
# dev profile: URL is fixed to jdbc:postgresql://localhost:5432/ridesharing_dev;
#              only DB_USERNAME / DB_PASSWORD are read.
# prod profile: all five are required.
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=your-db-name
DB_USERNAME=your-db-username
DB_PASSWORD=change-me

# ── Redis ── (prod: required)
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Kafka ── (prod: required)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── JWT ──
# HMAC-SHA signing key, at least 32 bytes. Generate a random value; do not reuse examples.
# WARNING: if unset, the application currently falls back to a built-in default key
# (known security issue, not yet fixed). Always set this outside local development.
JWT_SECRET=replace-with-a-long-random-secret
# Optional overrides (milliseconds); defaults are 900000 (15 min) and 604800000 (7 days)
# JWT_ACCESS_TOKEN_EXPIRY=900000
# JWT_REFRESH_TOKEN_EXPIRY=604800000

# ── Administrator bootstrap ── (optional; set both or neither)
# Creates this ADMIN account at startup if it does not exist. There is no default password.
# Existing administrators are never reset on restart. The only exception is the unusable
# account seeded by migration V7: if you use its email, its password is replaced once.
# Password: at least 12 characters. It is never logged.
NAVIROUTE_ADMIN_EMAIL=admin@example.com
NAVIROUTE_ADMIN_PASSWORD=replace-with-a-strong-password
