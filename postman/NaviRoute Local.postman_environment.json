{
  "name": "NaviRoute Local",
  "values": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "default",
      "enabled": true
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com",
      "type": "default",
      "enabled": true
    },
    {
      "key": "adminPassword",
      "value": "<same as NAVIROUTE_ADMIN_PASSWORD>",
      "type": "secret",
      "enabled": true
    },
    {
      "key": "metricsUsername",
      "value": "prometheus",
      "type": "default",
      "enabled": true
    },
    {
      "key": "metricsPassword",
      "value": "<same as NAVIROUTE_METRICS_PASSWORD (optional)>",
      "type": "secret",
      "enabled": true
    }
  ],
  "_postman_variable_scope": "environment"
}
